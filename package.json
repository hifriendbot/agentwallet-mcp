{
  "name": "agentwallet-mcp",
  "mcpName": "io.github.hifriendbot/agentwallet",
  "version": "1.10.4",
  "description": "MCP server for AgentWallet: self-custody local signing on EVM and Solana, or hosted wallets. Sign, broadcast, pay x402 invoices, and accept x402 payments.",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "agentwallet-mcp": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "test": "node test/x402-payment.test.mjs && node test/token-cap.test.mjs && node test/spl-cap.test.mjs && node test/local-mode.test.mjs && node test/ssrf-guard.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wallet",
    "ai-agent",
    "blockchain",
    "evm",
    "ethereum",
    "base",
    "arbitrum",
    "optimism",
    "polygon",
    "avalanche",
    "bsc",
    "zora",
    "pulsechain",
    "solana",
    "spl-token",
    "erc20",
    "token-transfer",
    "transaction-signing",
    "x402",
    "http-402",
    "agent-payments",
    "agentwallet",
    "self-custody",
    "non-custodial",
    "local-signing"
  ],
  "author": "HiFriendbot (https://hifriendbot.com)",
  "license": "MIT",
  "homepage": "https://hifriendbot.com/wallet/",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.4",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "undici": "^8.9.0",
    "viem": "^2.55.10",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
